# =====================================================================
# Unity (the project lives in UnityProject/, so paths are anchored there)
# =====================================================================
/UnityProject/[Ll]ibrary/
/UnityProject/[Tt]emp/
/UnityProject/[Oo]bj/
/UnityProject/[Bb]uild/
/UnityProject/[Bb]uilds/
/UnityProject/[Ll]ogs/
/UnityProject/[Uu]ser[Ss]ettings/
/UnityProject/[Mm]emoryCaptures/
/UnityProject/[Rr]ecordings/

# Asset Store tools / plugins that write local state
/UnityProject/[Aa]ssets/AssetStoreTools*
/UnityProject/[Aa]ssets/Plugins/Editor/JetBrains*

# Generated IDE project files: Unity regenerates them (Preferences > External Tools)
/UnityProject/*.csproj
/UnityProject/*.unityproj
/UnityProject/*.sln
/UnityProject/*.slnx
/UnityProject/*.suo
/UnityProject/*.user
/UnityProject/*.userprefs
/UnityProject/*.pidb
/UnityProject/*.booproj
/UnityProject/*.svd
/UnityProject/*.pdb
/UnityProject/*.mdb
/UnityProject/*.opendb
/UnityProject/*.VC.db

# Unity-generated .meta for folders/files that are themselves ignored.
# (Do NOT add '*.meta' here. Meta files must ALWAYS be committed.)
/UnityProject/[Mm]emoryCaptures.meta

# Build artifacts
/UnityProject/[Bb]uilds/
/UnityProject/[Bb]uild/
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
/UnityProject/[Aa]ssets/[Ss]treamingAssets/aa.meta
/UnityProject/[Aa]ssets/[Ss]treamingAssets/aa/*

# Addressables local build output (re-generated by content builds)
/UnityProject/ServerData/

# Burst debug info
/UnityProject/*_BurstDebugInformation_DoNotShip/

# =====================================================================
# .NET (csharp-basics)
# =====================================================================
/csharp-basics/**/[Bb]in/
/csharp-basics/**/[Oo]bj/
*.user
*.suo
.vs/
TestResults/

# =====================================================================
# IDEs / OS
# =====================================================================
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files written during builds by com.unity.test-framework.performance (a URP dependency)
/UnityProject/Assets/Resources/PerformanceTestRun*
